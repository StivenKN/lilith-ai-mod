  // checked with the companion.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["chrome"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["background.ts", "page.ts"]
}
