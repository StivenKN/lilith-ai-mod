{
  "name": "lilith-ai-companion",
  "version": "0.1.0-beta.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "sim": "bun scripts/sim.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension",
    "build": "bun build.ts",
    "check": "tsc --noEmit && tsc --noEmit -p extension && bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource/corben": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
