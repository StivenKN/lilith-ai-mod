<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Game plugin for BepInEx 6 (IL2CPP). Two ways to build it:

    1. Against your installed game (development; catches API changes at compile time):
         dotnet build -c Release -p:GameDir="C:\...\The NOexistenceN of Lilith"
       BepInEx must have run once in that game so BepInEx\interop exists.

    2. Without the game (CI and releases), against the pinned BepInEx build plus the reference
       stand-ins in reference/:
         dotnet build -c Release -p:BepInExDir="<extracted BepInEx zip>" -p:UseReferenceStubs=true

    You can put GameDir in a git-ignored Directory.Build.props next to this file. See docs/BUILDING.md.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>LilithAICompanion</AssemblyName>
    <RootNamespace>LilithAICompanion</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>embedded</DebugType>
    <Version>0.1.0</Version>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\The NOexistenceN of Lilith</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)</BepInExDir>
    <CoreDir>$(BepInExDir)\BepInEx\core</CoreDir>
    <InteropDir>$(GameDir)\BepInEx\interop</InteropDir>
    <UseReferenceStubs Condition="'$(UseReferenceStubs)' == ''">false</UseReferenceStubs>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="harness\**;reference\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(CoreDir)\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(CoreDir)\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(CoreDir)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- The game's real interop assemblies. -->
  <ItemGroup Condition="'$(UseReferenceStubs)' != 'true'">
    <Reference Include="Il2Cppmscorlib"><HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(InteropDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Reference-only stand-ins (never copied to the output). -->
  <ItemGroup Condition="'$(UseReferenceStubs)' == 'true'">
    <ProjectReference Include="reference\Il2Cppmscorlib\Il2Cppmscorlib.csproj" Private="false" />
    <ProjectReference Include="reference\UnityEngine.CoreModule\UnityEngine.CoreModule.csproj" Private="false" />
    <ProjectReference Include="reference\Assembly-CSharp\Assembly-CSharp.csproj" Private="false" />
  </ItemGroup>

  <Target Name="CheckBuildInputs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(CoreDir)\BepInEx.Core.dll')"
           Text="BepInEx not found in $(CoreDir). Pass -p:GameDir=&quot;your game folder&quot; (with BepInEx installed), or -p:BepInExDir=&quot;extracted BepInEx zip&quot; -p:UseReferenceStubs=true." />
    <Error Condition="'$(UseReferenceStubs)' != 'true' And !Exists('$(InteropDir)\Assembly-CSharp.dll')"
           Text="Game interop assemblies not found in $(InteropDir). Launch the game once with BepInEx installed (it generates them), or build with -p:UseReferenceStubs=true." />
  </Target>

</Project>
